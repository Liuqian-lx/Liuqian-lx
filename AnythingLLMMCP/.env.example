ANYTHINGLLM_URL=http://localhost:3001/api
ANYTHINGLLM_API_KEY=your-anythingllm-api-key
# Optional: pin the workspace instead of auto-detecting the single workspace.
# ANYTHINGLLM_WORKSPACE_SLUG=workspace-slug
# Optional: fixed session id used to keep rolling chat history in the workspace.
ANYTHINGLLM_SESSION_ID=mcp-anythingllm-workspace

MCP_HOST=0.0.0.0
MCP_PORT=8091
MCP_PATH=/mcp
MCP_LOG_LEVEL=INFO
